# 컨테이너 안에서 정적 파일을 서빙한다. HTTPS 는 서버 앞단의 Caddy 가 처리한다.
:80 {
	root * /srv
	encode zstd gzip

	# 해시가 붙은 빌드 산출물은 오래 캐시하고, 그 외(index.html 등)는 매번 확인한다.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@not_assets not path /assets/*
	header @not_assets Cache-Control "no-cache"

	# SPA 라우팅: 파일이 없으면 index.html 로 넘긴다.
	try_files {path} /index.html
	file_server
}
